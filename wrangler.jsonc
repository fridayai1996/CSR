{
  "name": "sss-csr-portal",
  "// SECURITY": "Do NOT commit real account_id or database_id. Use wrangler login + wrangler d1 commands or .dev.vars for secrets.",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sss-csr-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
